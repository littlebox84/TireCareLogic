  "safetyRules": [
    {"id":"recommended-size-type-only","severity":"critical","rule":"Use only the size and type tube, and flap if required, recommended for the tire.","source":"Bridgestone Americas Tube Business"},
    {"id":"radial-with-radial","severity":"critical","rule":"Only radial tubes and radial flaps may be used with radial tires.","source":"Bridgestone Americas Tube Business"},
    {"id":"new-tire-new-tube","severity":"critical","rule":"Use new tubes and new flaps, if required, in new tires. Do not use creased, buckled, or damaged tubes/flaps.","source":"Bridgestone Americas Tube Business"},
    {"id":"tr13-b6-bushing","severity":"warning","rule":"A TR13 valve used in a 0.625 inch TR15 rim hole may require the proper B6 bushing; improper use can cause valve failure.","source":"Bridgestone Americas Tube Business"},
    {"id":"tr440-445-slot","severity":"warning","rule":"TR440-TR445 bent valve family is intended for slotted rims.","source":"Bridgestone Americas Tube Business"}
